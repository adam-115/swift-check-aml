<?xml version="1.0" encoding="UTF-8"?>
<!--
    Catégorie PEP active ou désactivée depuis l'écran « Catégories PEP ».
    Une catégorie désactivée reste en base avec ses fonctions, mais n'apparaît plus dans la page « Couverture PEP ».
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-pep-category-active" author="swiftcheck">
        <addColumn tableName="pep_category">
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
