<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Plugins de listes de sanctions (swiftcheck-aml-plugins/sanction/<fournisseur>) : une liste = un parser.
      Ils remplacent a terme les fichiers poses a la main dans yente/data (onu_sanctions, ofac_sanctions, uksl, seco,
      dfat, canada-sanctions, dgtresor, us-bis) : retirer ces anciens datasets du manifest Yente une fois les nouveaux
      publies, sinon chaque personne apparait deux fois.
      Retention 0 : une radiation s'applique tout de suite. Les dataset_name finissent par _sanctions (classement
      « sanction » dans AmlVerificationService).
    -->
    <changeSet id="158-register-sanction-plugins" author="swiftcheck" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM parser WHERE dataset_name IN ('un_sc_sanctions','us_ofac_sdn_sanctions','us_ofac_consolidated_sanctions','us_csl_sanctions','uk_fcdo_sanctions','ca_sema_sanctions','ca_terrorist_sanctions','ch_seco_sanctions','fr_dgtresor_sanctions','au_dfat_sanctions','jp_mof_sanctions','nz_mfat_sanctions','nl_terror_sanctions','pl_mswia_sanctions','be_national_sanctions')</sqlCheck>
        </preConditions>
