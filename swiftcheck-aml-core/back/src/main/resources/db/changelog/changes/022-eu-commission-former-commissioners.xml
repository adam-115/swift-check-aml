<?xml version="1.0" encoding="UTF-8"?>
<!--
    lu_pep_eu_commission : la page du collège ne liste que les commissaires en fonction. Les anciens commissaires
    luxembourgeois encore dans la rétention (5 ans) sont lus dans leurs fiches d'archive, listées dans le paramètre
    formerCommissionerPages (une URL par ligne). Nicolas Schmit : commissaire 2019-2024, retenu jusqu'à fin 2029.
    JSON_SET garde les autres paramètres tels qu'ils sont en base.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="022-eu-commission-former-commissioners" author="swiftcheck">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM parser WHERE dataset_name = 'lu_pep_eu_commission'
            </sqlCheck>
        </preConditions>
        <sql>
            UPDATE parser
               SET parameters = JSON_SET(COALESCE(NULLIF(parameters, ''), '{}'),
                                         '$.formerCommissionerPages',
                                         'https://commissioners.ec.europa.eu/nicolas-schmit_fr')
             WHERE dataset_name = 'lu_pep_eu_commission';
        </sql>
    </changeSet>

</databaseChangeLog>
