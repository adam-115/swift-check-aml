        <update tableName="parser">
            <column name="parameters"><![CDATA[{"landraeteUrl":"https://www.landkreistag.de/der-verband/landesverbaende/mittelbare-mitglieder","populationUrl":"https://www.destatis.de/DE/Themen/Laender-Regionen/Regionales/Gemeindeverzeichnis/Administrativ/Archiv/GVAuszugQ/AuszugGV3QAktuell.xlsx?__blob=publicationFile","mayorSources":"[{\"land\":\"BY\",\"publisher\":\"Bayerisches Landesamt für Statistik\",\"url\":\"https://www.statistik.bayern.de/mam/wahlen/kommunalwahlen/bgm/wahlergebnisse_mandatsr%C3%A4ger.xlsx\",\"format\":\"xlsx\",\"sheet\":\"Mandatsträger\",\"agsPrefix\":\"09\",\"nameOrder\":\"lastFirst\",\"roles\":\"(?i)bürgermeister\",\"columns\":{\"key\":\"Schlüssel\",\"place\":\"Gemeindename/Landkreis\",\"role\":\"Amtsbezeichnung\",\"name\":\"Amtsinhaber/in\",\"gender\":\"Geschlecht\",\"birthYear\":\"Geburtsjahr\",\"party\":\"Wahlvorschlag\",\"start\":\"Erster Amtsantritt\"}},{\"land\":\"NW\",\"publisher\":\"Landeswahlleiterin Nordrhein-Westfalen (résultats des élections communales 2025)\",\"format\":\"perCity\",\"nameOrder\":\"lastFirst\",\"url\":\"https://www.wahlergebnisse.nrw/kommunalwahlen/2025/aktuell/txtdateien/b{ags6}kw2500.txt\",\"elected\":\"gewählt:\\\\s*\\\\R\\\\s*(.+?)\\\\s*\\\\(([^()]*)\\\\)\\\\s*\\\\R\\\\s*(\\\\d{2}\\\\.\\\\d{2}\\\\.\\\\d{4})\",\"roleFrom\":\"Wahl der ((?:Ober)?[Bb]ürgermeister)\",\"keyAliases\":{\"05334002\":\"313000\"}}]","landratRoles":"{\"Region Hannover\":\"Regionspräsident\",\"StädteRegion Aachen\":\"Städteregionsrat\",\"Regionalverband Saarbrücken\":\"Regionalverbandsdirektor\"}","minPopulation":"50000","delayMs":"1000","wikidataFallback":"true","endpoint":"https://query.wikidata.org/sparql"}]]></column>
            <where>dataset_name = 'de_pep_local_executives'</where>
        </update>
        <sql>
            UPDATE pep_function_parser
               SET completeness = 'COMPLETE',
                   includes_former = 0,
                   covered_scope = 'Juges en fonction lus dans le plan de repartition officiel de la cour (nom, titre, fonction, genre) ; prenom lu dans les communiques d''election du BMJV et du BMAS, le rapport annuel de la cour ou ses communiques de nomination, sinon dans la liste Wikipedia DE des juges (complement, note sur la fiche) ; president et vice-president lus sur la page officielle de la cour.',
                   gaps = 'Wikipedia ne sert qu''au prenom d''un juge du plan sans prenom officiel (meme cour, meme nom, meme initiale, en fonction) : fiche marquee non confirmee. Quelques juges sans prenom ni officiel ni Wikipedia sont publies avec le nom de famille seul. Pas de date de naissance ni de date de prise de fonctions pour les juges des plans ; juges sortis non conserves.'
             WHERE parser_id = (SELECT id FROM parser WHERE dataset_name = 'de_pep_federal_courts')
               AND function_id IN (132, 133, 134, 135, 136);
            UPDATE pep_function_parser
               SET completeness = 'COMPLETE',
                   covered_scope = 'Maires des villes de 50 000 habitants ou plus : listes officielles de la Baviere (Bayerisches Landesamt fuer Statistik) et de la NRW (resultats officiels des elections communales 2025) ; pour les autres Laender, complement Wikidata par cle AGS (fiche marquee a confirmer) ; population lue dans le repertoire des communes de Destatis.',
                   gaps = 'Environ 97 villes ne sont couvertes que par Wikidata (Bade-Wurtemberg, Basse-Saxe, Hesse, Rhenanie-Palatinat...) en attendant les listes officielles de leur Land ; une ville avec plusieurs titulaires possibles dans Wikidata n''est pas publiee (message d''execution).'
             WHERE parser_id = (SELECT id FROM parser WHERE dataset_name = 'de_pep_local_executives') AND function_id = 145;
            UPDATE pep_function_parser
               SET completeness = 'COMPLETE',
                   covered_scope = 'Chefs de l''executif des 294 Landkreise (Landrat, Landraetin ; Staedteregionsrat d''Aachen, Regionspraesident de Hanovre, Regionalverbandsdirektor de Sarrebruck), lus sur la page Landkreise und Landraete du Deutscher Landkreistag.',
                   gaps = 'Ni date de naissance ni date de prise de fonctions ni parti (la page du Landkreistag ne les donne pas). Liste mise a jour par le Landkreistag : un changement tres recent peut manquer.'
             WHERE parser_id = (SELECT id FROM parser WHERE dataset_name = 'de_pep_local_executives') AND function_id = 146;
        </sql>
