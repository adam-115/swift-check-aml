<?xml version="1.0" encoding="UTF-8"?>
<!--
    Re-test des échecs : un test peut en reprendre un autre et ne revérifier dans Yente que ses éléments en échec.
    retest_of_id = test d'origine (NULL pour un test complet).
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="075-parser-test-retest" author="swiftcheck">
        <addColumn tableName="parser_test">
            <column name="retest_of_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
