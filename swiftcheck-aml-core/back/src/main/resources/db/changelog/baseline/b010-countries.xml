    <changeSet id="baseline-country-AT" author="swiftcheck-baseline">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM country WHERE iso = 'AT'</sqlCheck>
        </preConditions>
        <comment>Pays AT (Autriche)</comment>
        <insert tableName="country">
            <column name="iso" value="AT"/>
            <column name="name" value="Autriche"/>
            <column name="eu_member" valueNumeric="1"/>
            <column name="legal_basis" value="Finanzmarkt-Geldwäschegesetz (FM-GwG) § 2 Z 6 lit. a à h, § 11 : au moins douze mois après la fin des fonctions"/>
            <column name="retention_months" valueNumeric="12"/>
            <column name="official_list_reference" value="JO C/2023/724 (section Autriche) ; FM-GwG § 2 Z 6"/>
            <column name="official_list_date" value="2023-10-24"/>
            <column name="official_list_url" value="https://eur-lex.europa.eu/legal-content/FR/TXT/?uri=OJ:C_202300724"/>
        </insert>
    </changeSet>

