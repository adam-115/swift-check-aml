<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      1. Baseline (17/11/2026) : schéma et données de référence (pays, catégories et fonctions PEP, parsers, liens,
         configuration) avec leurs identifiants. Générée par swiftcheck-aml-tools/liquibase-baseline/generate-baseline.js
         à partir de la base de référence. Chaque changeSet est marqué comme exécuté (MARK_RAN) si ses données sont déjà
         en base : le même changelog crée une base vide (VPS) et ne change rien sur une base existante.

      2. Changements suivants : db/changelog/changes, numérotés à partir de 156. Règles :
         - jamais d'identifiant numérique en dur : viser les lignes par une clé stable (parser.dataset_name,
           pep_category.code, libellé de fonction) ;
         - jamais de chemin de machine : utiliser un paramètre Liquibase (spring.liquibase.parameters.*) ;
         - ne jamais modifier un changeSet déjà appliqué : en ajouter un nouveau.

      Les anciens changeSets (001 à 155) sont gardés dans db/changelog/legacy pour l'historique ; ils ne sont plus
      exécutés : la baseline contient leur résultat.
    -->

    <include file="db/changelog/baseline/baseline.xml"/>

    <include file="db/changelog/changes/156-register-de-pep-eu-institutions-defence-attaches.xml"/>
    <include file="db/changelog/changes/157-yente-monitoring-config.xml"/>
    <include file="db/changelog/changes/158-register-sanction-plugins.xml"/>
    <include file="db/changelog/changes/159-register-de-pep-dip.xml"/>
    <include file="db/changelog/changes/160-de-pep-bundesbank-hubs.xml"/>
    <include file="db/changelog/changes/161-de-pep-defence-vita-urls.xml"/>
    <include file="db/changelog/changes/162-de-pep-lobbyregister-pep-correlation.xml"/>

</databaseChangeLog>
