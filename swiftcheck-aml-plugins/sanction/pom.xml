<?xml version="1.0" encoding="UTF-8"?>
<!--
    Parent et agrégateur des plugins de listes de sanctions (un dossier par fournisseur : un, ofac, uk, ...).

    Chaque plugin hérite d'ici :
      - les dépendances fournies par le core (swiftcheck-aml-api, pf4j, jackson, slf4j) ;
      - la bibliothèque commune swiftcheck-aml-sanction-common (modèle de fiche, HTTP, lecture XLSX) et jsoup,
        copiées dans le JAR du plugin par maven-shade-plugin (le core ne les fournit pas) ;
      - le MANIFEST PF4J (Plugin-Id = propriété plugin.id du plugin).

    Construire tous les plugins de sanctions :  mvn -pl swiftcheck-aml-plugins/sanction -amd package
    Un seul :                                  mvn -pl swiftcheck-aml-plugins/sanction/un/swiftcheck-aml-un-sc-sanctions -am package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.swiftcheck.aml</groupId>
        <artifactId>swiftcheck-aml</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>swiftcheck-aml-sanction-parent</artifactId>
    <packaging>pom</packaging>
    <name>SwiftCheck AML - plugins de sanctions</name>

    <properties>
        <plugin.version>1.0.0</plugin.version>
        <plugin.provider>SwiftCheck</plugin.provider>
        <jsoup.version>1.18.1</jsoup.version>
        <pdfbox.version>2.0.31</pdfbox.version>
    </properties>

    <modules>
        <module>swiftcheck-aml-sanction-common</module>
        <module>un/swiftcheck-aml-un-sc-sanctions</module>
        <module>ofac/swiftcheck-aml-us-ofac-sanctions</module>
        <module>us-trade/swiftcheck-aml-us-csl-sanctions</module>
        <module>uk/swiftcheck-aml-uk-fcdo-sanctions</module>
        <module>ca/swiftcheck-aml-ca-sema-sanctions</module>
        <module>ch/swiftcheck-aml-ch-seco-sanctions</module>
        <module>fr/swiftcheck-aml-fr-dgtresor-sanctions</module>
        <module>jp/swiftcheck-aml-jp-mof-sanctions</module>
        <module>nl/swiftcheck-aml-nl-terror-sanctions</module>
        <module>pl/swiftcheck-aml-pl-mswia-sanctions</module>
        <module>nz/swiftcheck-aml-nz-mfat-sanctions</module>
        <module>au/swiftcheck-aml-au-dfat-sanctions</module>
        <module>ca/swiftcheck-aml-ca-terrorist-sanctions</module>
        <module>be/swiftcheck-aml-be-national-sanctions</module>
        <!-- SANCTION-MODULES (un module par liste ; garder cette ligne pour les ajouts) -->
    </modules>

    <dependencies>
        <dependency>
            <groupId>com.swiftcheck.aml</groupId>
            <artifactId>swiftcheck-aml-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.swiftcheck.aml</groupId>
            <artifactId>swiftcheck-aml-sanction-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Plugin-Id>${plugin.id}</Plugin-Id>
                            <Plugin-Version>${plugin.version}</Plugin-Version>
                            <Plugin-Provider>${plugin.provider}</Plugin-Provider>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.swiftcheck.aml:swiftcheck-aml-sanction-common</include>
                                    <include>org.jsoup:jsoup</include>
                                    <include>org.apache.pdfbox:*</include>
                                    <include>commons-logging:commons-logging</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
