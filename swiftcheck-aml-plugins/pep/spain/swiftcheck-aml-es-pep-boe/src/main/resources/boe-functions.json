{
  "_comment": "Fonctions PEP reconnues dans les titres du BOE (section II.A). Une entrée : key = identifiant stable, category = bloc du référentiel (loi 10/2010, art. 14), pattern = expression sur le libellé de la fonction (insensible à la casse), labelGroup = groupe de capture à utiliser comme libellé (sinon le libellé complet), group = fonctions qui se remplacent (un grade militaire remplace le précédent).",
  "functions": [
    { "key": "presidente-gobierno", "category": "ES-a", "organization": "Gobierno de España",
      "topics": ["gov.head", "gov.executive", "gov.national"],
      "pattern": "^Presidente del Gobierno$" },
    { "key": "vicepresidente-gobierno", "category": "ES-a", "organization": "Gobierno de España",
      "topics": ["gov.executive", "gov.national"],
      "pattern": "^Vicepresident[ea]\\b.*\\bdel Gobierno\\b" },
    { "key": "ministro", "category": "ES-a", "organization": "Gobierno de España",
      "topics": ["gov.executive", "gov.national"],
      "pattern": "^Ministr[oa]\\b" },
    { "key": "secretario-estado", "category": "ES-a", "organization": "Gobierno de España",
      "topics": ["gov.executive", "gov.national"],
      "pattern": "^Secretari[oa] de Estado\\b" },
    { "key": "subsecretario", "category": "ES-a", "organization": "Gobierno de España",
      "topics": ["gov.executive", "gov.national"],
      "pattern": "^Subsecretari[oa]\\b" },

    { "key": "tribunal-constitucional", "category": "ES-c", "organization": "Tribunal Constitucional",
      "topics": ["gov.judicial", "gov.national"],
      "pattern": "^(?:Magistrad[oa]|Presidente|Presidenta|Vicepresidente|Vicepresidenta)\\b.*\\bTribunal Constitucional\\b" },
    { "key": "tribunal-supremo", "category": "ES-c", "organization": "Tribunal Supremo",
      "topics": ["gov.judicial", "gov.national"],
      "pattern": "^(?!.*(?:Gabinete|Letrad|Fiscal)).*\\b(?:Magistrad[oa]|Presidente|Presidenta|Vicepresidente|Vicepresidenta)\\b.*\\bTribunal Supremo\\b" },
    { "key": "consejo-poder-judicial", "category": "ES-c", "organization": "Consejo General del Poder Judicial",
      "topics": ["gov.judicial", "gov.national"],
      "pattern": "^(?:Presidente|Presidenta|Vicepresidente|Vicepresidenta|Vocal)\\b.*\\bConsejo General del Poder Judicial\\b" },
    { "key": "audiencia-nacional", "category": "ES-c", "organization": "Audiencia Nacional",
      "topics": ["gov.judicial", "gov.national"],
      "pattern": "^Presidente[a]?(?: de Sala)? de la Audiencia Nacional\\b" },
    { "key": "tribunal-superior-justicia", "category": "ES-c", "organization": "Tribunal Superior de Justicia",
      "topics": ["gov.judicial", "gov.regional"],
      "pattern": "^Presidente[a]? del Tribunal Superior de Justicia\\b" },
    { "key": "fiscal-jefe", "category": "ES-c", "organization": "Ministerio Fiscal",
      "topics": ["gov.judicial", "gov.national"],
      "pattern": "^(?:Fiscal General del Estado|Fiscal de Sala\\b|Fiscal Superior\\b|Fiscal Jef[ea] (?:de la )?(?:Fiscalía )?(?:Anticorrupción|Antidroga|contra la Corrupción))" },

    { "key": "banco-de-espana", "category": "ES-d", "organization": "Banco de España",
      "topics": ["gov.financial", "gov.national"],
      "pattern": "^(?:Gobernador|Gobernadora|Subgobernador|Subgobernadora|Consejer[oa]|Director[a]? General)\\b.*\\bBanco de España\\b" },
    { "key": "tribunal-de-cuentas", "category": "ES-d", "organization": "Tribunal de Cuentas",
      "topics": ["gov.financial", "gov.national"],
      "pattern": "^(?:Presidente|Presidenta|Consejer[oa]|Fiscal)\\b.*\\bTribunal de Cuentas\\b" },

    { "key": "embajador", "category": "ES-e", "organization": "Ministerio de Asuntos Exteriores, Unión Europea y Cooperación",
      "topics": ["role.diplo", "gov.diplomatic"],
      "pattern": "^(?:Embajador|Embajadora|Representante Permanente|Encargad[oa] de Negocios)\\b" },
    { "key": "militar", "category": "ES-e", "organization": "Fuerzas Armadas", "group": "militar",
      "topics": ["gov.security", "gov.national"], "labelGroup": 1,
      "pattern": "^(Capitán General|General de Ejército|Almirante General|Almirante|Teniente General|General de División|Vicealmirante|General del Aire)\\b" },
    { "key": "jefe-estado-mayor", "category": "ES-e", "organization": "Fuerzas Armadas",
      "topics": ["gov.security", "gov.national"],
      "pattern": "^Jef[ea] (?:del|de) Estado Mayor\\b" },

    { "key": "delegado-gobierno", "category": "ES-f", "organization": "Administración General del Estado",
      "topics": ["gov.executive", "gov.state"],
      "pattern": "^Delegad[oa] del Gobierno\\b" },
    { "key": "secretario-general", "category": "ES-f", "organization": "Administración General del Estado",
      "topics": ["gov.executive", "gov.state"],
      "pattern": "^Secretari[oa] General\\b" },
    { "key": "director-general", "category": "ES-f", "organization": "Administración General del Estado",
      "topics": ["gov.executive", "gov.state"],
      "pattern": "^Director[a]? General\\b" },
    { "key": "regulador", "category": "ES-f", "organization": "Organismos reguladores",
      "topics": ["gov.financial", "gov.state"],
      "pattern": "^(?:Presidente|Presidenta|Vicepresidente|Vicepresidenta|Consejer[oa]|Vocal|Director|Directora)\\b.*\\b(?:Comisión Nacional del Mercado de Valores|Comisión Nacional de los Mercados y la Competencia|Consejo de Seguridad Nuclear|Agencia Española de Protección de Datos|Agencia Española de Supervisión de Inteligencia Artificial|Autoridad Independiente de Responsabilidad Fiscal|Consejo Económico y Social|Agencia Estatal de Administración Tributaria|Centro Nacional de Inteligencia|Instituto Nacional de Estadística)\\b" }
  ]
}
