<?xml version="1.0" encoding="UTF-8"?>
<!--
    Plugin PF4J : PEP Allemagne - Commandement de la Luftwaffe, escadres, ecoles et centres (bundeswehr.de).
    Construire :  mvn -pl swiftcheck-aml-plugins/pep/germany/swiftcheck-aml-de-pep-defence-luftwaffe -am package
    Deployer   :  copier target/swiftcheck-aml-de-pep-defence-luftwaffe-*.jar dans le dossier des plugins (pf4j.plugins.dir)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.swiftcheck.aml</groupId>
        <artifactId>swiftcheck-aml-de-pep</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>swiftcheck-aml-de-pep-defence-luftwaffe</artifactId>
    <packaging>jar</packaging>

    <properties>
        <plugin.id>de-pep-defence-luftwaffe</plugin.id>
        <plugin.version>1.0.0</plugin.version>
        <plugin.provider>SwiftCheck</plugin.provider>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.swiftcheck.aml</groupId>
            <artifactId>swiftcheck-aml-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lecture des CV PDF (Story 3) : bibliothèque partagée et PDFBox, embarquées par maven-shade -->
        <dependency>
            <groupId>com.swiftcheck.aml</groupId>
            <artifactId>swiftcheck-aml-de-pep-vita</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Plugin-Id>${plugin.id}</Plugin-Id>
                            <Plugin-Version>${plugin.version}</Plugin-Version>
                            <Plugin-Provider>${plugin.provider}</Plugin-Provider>
                            <Plugin-Class></Plugin-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.swiftcheck.aml:swiftcheck-aml-de-pep-vita</include>
                                    <include>org.apache.pdfbox:*</include>
                                    <include>commons-logging:commons-logging</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

